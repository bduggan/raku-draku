#!raku

use experimental :rakuast;
use Test;
use Draku::Extract;

plan 3;

sub top-paragraph(Str $src) {
  my $ast = $src.AST;
  my @found;
  sub walk($n) {
    @found.push($n) if $n ~~ RakuAST::Doc::Paragraph;
    $n.visit-children: &walk;
  }
  walk($ast);
  @found[0];
}

my $para = top-paragraph(q:to/END/);
=begin pod
See L<Raku Website|https://raku.org> for more.
=end pod
END

my @found-links = links($para);
is @found-links.elems, 1, 'extracted one link';
is @found-links[0]<name>, 'Raku Website', 'link name is correct';
is @found-links[0]<target>, 'https://raku.org', 'link target is correct';

done-testing;
