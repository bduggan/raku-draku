#!raku

use experimental :rakuast;
use Draku::Render;
use Test;

plan 1;

my $ast = q:to/END/.AST;
=begin pod
=head3 X<C<\h> and C<\H>>
=end pod
END

my @found;
sub walk($n) {
  @found.push($n) if $n ~~ RakuAST::Doc::Block && $n.type eq 'head';
  $n.visit-children: &walk;
}
walk($ast);

my $out = render(@found[0], :plain);

is $out, ' ─ \h  and  \H ─', 'nested heading, para, formatting code';

done-testing;
